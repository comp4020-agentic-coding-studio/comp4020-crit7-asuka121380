---
// The same plan entries as the requirements tree, laid out by time.
import StatusMark from "../components/StatusMark.astro";
import { courseUrl } from "../data/catalogue";
import Shell from "../layouts/Shell.astro";
import type { PlanEntry, Session } from "../lib/schema";
import { SESSIONS, STATUS_LABEL, termKey, termOrder } from "../lib/terms";
import { loadView } from "../lib/view";

const view = loadView();
const { program, entries, evaluation, catalogue, now } = view;

const years = entries.map((e) => e.year);
const first = Math.min(now.year - 1, ...years);
const last = Math.max(now.year + 2, ...years);
const nowOrder = termOrder(now.year, now.session);

const byTerm = new Map<string, PlanEntry[]>();
for (const e of entries) byTerm.set(termKey(e.year, e.session), [...(byTerm.get(termKey(e.year, e.session)) ?? []), e]);

const plan = Array.from({ length: last - first + 1 }, (_, i) => first + i).map((year) => ({
  year,
  terms: SESSIONS.filter((s) => s.id === "S1" || s.id === "S2" || byTerm.has(termKey(year, s.id))).map((s) => {
    const order = termOrder(year, s.id);
    const list = byTerm.get(termKey(year, s.id)) ?? [];
    return {
      year,
      session: s.id as Session,
      label: s.label,
      key: termKey(year, s.id),
      when: order < nowOrder ? "past" : order === nowOrder ? "now" : "future",
      list,
      units: list.reduce((n, e) => n + e.units, 0),
    };
  }),
}));

const hint = (e: PlanEntry, when: string) => {
  if (e.status === "planned" && when === "past") return "Planned for a term that has passed. Completed?";
  if (e.status === "completed" && when === "future") return "Marked completed in a future term.";
  if (e.status === "current" && when !== "now") return "Marked as studying now, but this isn't the current semester.";
  return null;
};
const totals = { completed: 0, current: 0, planned: 0 };
for (const e of entries) totals[e.status] += e.units;
---

<Shell title="Semester plan · My Degree Planner" view={view} active="plan">
  <div class="planview">
    <section class="hero hero--compact">
      <p class="eyebrow">{program ? `${program.code} · ${program.name}` : "No program chosen yet"}</p>
      <h1>Semester plan</h1>
      <p class="lede">
        The same courses as the requirements tree, in the order you take them. Change a course here and its node in the
        tree changes with it.
      </p>
      <p class="hero__breakdown">
        <span class="key key--completed">{totals.completed} units completed</span>
        <span class="key key--current">{totals.current} studying now</span>
        <span class="key key--planned">{totals.planned} planned</span>
        {program && <span class="key key--target">of {program.units} required</span>}
      </p>
      {!program && (
        <p>
          <a class="btn" href="/">Choose a program</a> to see where each course counts.
        </p>
      )}
    </section>

    <ol class="years" role="list">
      {
        plan.map((y) => (
          <li class="year">
            <h2 class="year__title">{y.year}</h2>
            <div class="year__terms">
              {y.terms.map((t) => (
                <section class="term" data-term={t.key} data-when={t.when} aria-label={`${t.year} ${t.label}`}>
                  <header class="term__head">
                    <h3 class="term__title">{t.label}</h3>
                    {t.when === "now" && <span class="badge badge--now">Now</span>}
                    <span class="term__units">{t.units} units</span>
                  </header>
                  {t.list.length > 0 && (
                    <ol class="term__list" role="list">
                      {t.list.map((e) => {
                        const course = catalogue.get(e.courseCode);
                        const toward = evaluation?.countsToward.get(e.id);
                        const warn = hint(e, t.when);
                        return (
                          <li class="entry" data-entry-course={e.courseCode} data-status={e.status}>
                            <button class="entry__main" type="button" data-open-course={e.courseCode} data-entry={e.id} aria-haspopup="dialog">
                              <StatusMark status={e.status} />
                              <span class="entry__code">{e.courseCode}</span>
                              <span class="entry__title">{course?.title ?? "Not in the planner's catalogue"}</span>
                              <span class="entry__units">{e.units} u</span>
                              <span class="entry__status">{STATUS_LABEL[e.status]}</span>
                              {program && (
                                <span class={`entry__toward${toward ? "" : " entry__toward--none"}`}>
                                  {toward ? `Counts toward ${toward.join(", ")}` : "Not counted towards a listed requirement"}
                                </span>
                              )}
                              {warn && <span class="entry__hint">{warn}</span>}
                            </button>
                            <a class="leaf__link" href={courseUrl(e.courseCode)} target="_blank" rel="noopener" aria-label={`${e.courseCode} on ANU Programs and Courses (opens in a new tab)`}>
                              <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
                                <path d="M6 3.5h6.5V10M12.2 3.8 4 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                              </svg>
                            </a>
                          </li>
                        );
                      })}
                    </ol>
                  )}
                  <button class="term__add" type="button" data-add-course data-year={t.year} data-session={t.session}>
                    <span aria-hidden="true">+</span> Add a course<span class="visually-hidden"> to {t.year} {t.label}</span>
                  </button>
                </section>
              ))}
            </div>
          </li>
        ))
      }
    </ol>
    <p class="planview__more">
      Summer, Autumn, Winter and Spring sessions appear once a course is placed in them. Pick the session when you add a
      course.
    </p>
  </div>
</Shell>
