---
// One course in the tree. The row opens the course panel; the arrow is a
// direct link to the official page. Taking a course and having it count
// here are different things, and the row says which.
import { courseUrl } from "../data/catalogue";
import { termsOccupied } from "../lib/checks";
import type { Credit } from "../lib/progress";
import type { Course, PlanEntry } from "../lib/schema";
import { STATUS_LABEL, termShort } from "../lib/terms";
import StatusMark from "./StatusMark.astro";

interface Props {
  code: string;
  course?: Course;
  entry?: PlanEntry;
  nodeId: string;
  credit?: Credit;
  // inside a pathway that isn't chosen: credit is hypothetical
  preview?: boolean;
  // this leaf sits in a "choose one" list, so the student can pick it
  chooseOne?: boolean;
  alternativesInPlan?: number;
  // counted nowhere because an incompatible course is already counting
  withheldBy?: string;
  listedAs?: string;
  target?: number;
}
const { code, course, entry, nodeId, credit, preview, chooseOne, alternativesInPlan = 0, withheldBy, listedAs, target } = Astro.props;
const title = course?.title ?? code;
const semesters = course?.semesters ?? 1;
const here = credit?.nodeId === nodeId;
const terms = entry ? termsOccupied(entry.year, entry.session, semesters) : [];
const when = terms.map((t) => termShort(t.year, t.session)).join(" – ");

let note = "";
if (entry) {
  if (here && preview) note = "Would count here if you choose this pathway";
  else if (here && chooseOne && alternativesInPlan > 1) note = "Counts here";
  else if (!here && credit) note = preview ? `Counts toward ${credit.title} for now` : `Counts toward ${credit.title} instead`;
  else if (!here && preview) note = "Choose this pathway to use it here";
  else if (!here)
    note = `Recorded in your study history · 0 units currently counted toward this degree${withheldBy ? ` (the 2027 course pages list it as incompatible with ${withheldBy}, which is counting)` : ""}`;
}
---

<li
  class="leaf"
  data-course={code}
  data-status={entry?.status ?? "none"}
  data-counts={entry ? (here ? "here" : credit ? "elsewhere" : "none") : undefined}
  data-listed={listedAs}
>
  <button class="leaf__main" type="button" data-open-course={code} aria-haspopup="dialog">
    <StatusMark status={entry?.status ?? "none"} />
    <span class="leaf__code">{code}</span>
    <span class="leaf__title">
      {title}
      {listedAs && <span class="leaf__listed">Listed as “{listedAs}”</span>}
    </span>
    <span class="leaf__meta">
      {
        target !== undefined && (
          <span class="leaf__units">{semesters > 1 ? `${target / semesters} units × ${semesters} semesters` : `${target} units`}</span>
        )
      }
    </span>
    <span class="leaf__state">
      {
        entry ? (
          <>
            <span class={`state state--${entry.status}`}>
              <span class="state__label">{STATUS_LABEL[entry.status]}</span> · {when}
            </span>
            {note && <span class={`credit credit--${here ? "here" : "elsewhere"}`}>{note}</span>}
          </>
        ) : (
          <span class="state state--none">{STATUS_LABEL.none}</span>
        )
      }
    </span>
  </button>
  {
    entry && chooseOne && !here && !preview && (
      <form class="leaf__use" method="post" action="/api/selections" data-enhance data-astro-reload>
        <input type="hidden" name="node" value={nodeId} />
        <input type="hidden" name="course" value={code} />
        <button class="linkish" aria-label={`Count ${code} toward this requirement instead`}>
          Count this one here
        </button>
      </form>
    )
  }
  <a
    class="leaf__link"
    href={courseUrl(code)}
    target="_blank"
    rel="noopener"
    aria-label={`${code} on ANU Programs and Courses (opens in a new tab)`}
  >
    <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
      <path d="M6 3.5h6.5V10M12.2 3.8 4 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </a>
</li>
