---
// One requirement node, rendered recursively. Groups are <details> so the
// hierarchy works (and stays accessible) before any script runs; the client
// script adds the animated expansion and the mobile drill-down.
import type { OneNode, ReqNode } from "../lib/requirements";
import type { Evaluation } from "../lib/progress";
import { courseTarget, filled, isChooseOne } from "../lib/progress";
import type { Course } from "../lib/schema";
import { relation, ruleLine } from "../lib/describe";
import Leaf from "./Leaf.astro";
import Meter from "./Meter.astro";
import RelGlyph from "./RelGlyph.astro";

interface Props {
  node: ReqNode;
  evaluation: Evaluation;
  catalogue: Map<string, Course>;
  choices: Record<string, string>;
  // set when this node is a pathway inside a "one of" requirement
  pathwayOf?: OneNode;
  // the group a course leaf sits in
  parent?: ReqNode;
  // inside a pathway that isn't chosen: show what it would hold
  preview?: boolean;
}
const { node, evaluation, catalogue, choices, pathwayOf, parent, preview = false } = Astro.props;
const Self = Astro.self;

const rel = relation(node);
const [lead, rest] = ruleLine(node, catalogue);
const chosenId = pathwayOf ? choices[pathwayOf.id] : undefined;
const inPreview = preview || Boolean(pathwayOf && chosenId !== node.id);
const tally = node.kind === "course" ? undefined : (inPreview ? evaluation.preview : evaluation.tally).get(node.id);
const chooseOne = node.kind === "pick" && isChooseOne(node, catalogue);
const bucketEntries =
  node.kind === "open"
    ? [...evaluation.byCode.values()].filter((e) => (inPreview ? evaluation.previewCredit : evaluation.credit).get(e.id)?.nodeId === node.id)
    : [];
const leafEntry = node.kind === "course" ? evaluation.byCode.get(node.code) : undefined;
const isChosen = pathwayOf && chosenId === node.id;
const isMuted = pathwayOf && chosenId && chosenId !== node.id;
const isBest = pathwayOf && !chosenId && evaluation.bestOption.get(pathwayOf.id) === node.id;
const chosenOption = node.kind === "one" ? node.options.find((o) => o.id === choices[node.id]) : undefined;
---

{
  node.kind === "course" ? (
    <Leaf
      code={node.code}
      course={catalogue.get(node.code)}
      entry={leafEntry}
      nodeId={parent?.id ?? ""}
      credit={leafEntry ? (preview ? (evaluation.previewCredit.get(leafEntry.id) ?? evaluation.credit.get(leafEntry.id)) : evaluation.credit.get(leafEntry.id)) : undefined}
      preview={preview}
      chooseOne={parent !== undefined && isChooseOne(parent, catalogue)}
      alternativesInPlan={parent && parent.kind === "pick" ? parent.children.filter((c) => c.kind === "course" && evaluation.byCode.has(c.code)).length : 0}
      listedAs={node.listedAs}
      target={courseTarget(node, catalogue)}
    />
  ) : (
    <li class={`node node--${rel}`} data-rel={rel} data-pathway={pathwayOf ? (isChosen ? "chosen" : isMuted ? "muted" : "open") : undefined}>
      <details data-node={node.id} class="group">
        <summary class="group__head">
          <span class="group__glyph">
            <RelGlyph rel={rel} />
          </span>
          <span class="group__titles">
            <span class="group__title">
              {node.title}
              {isChosen && <span class="badge badge--chosen">Your pathway</span>}
              {isBest && <span class="badge">Closest match so far</span>}
              {chooseOne && evaluation.selections[node.id] && <span class="badge">You picked {evaluation.selections[node.id]}</span>}
            </span>
            <span class="group__rule">
              <span class="group__rel">{lead}</span>
              {rest && <span aria-hidden="true"> · </span>}
              {rest}
              {node.kind === "one" && (
                <span class="group__choice">
                  <span aria-hidden="true"> · </span>
                  {chosenOption ? chosenOption.title : "no pathway chosen"}
                </span>
              )}
            </span>
          </span>
          {tally && (
            <span class="group__progress">
              <Meter tally={tally} id={node.id} />
              <span class="group__fraction" title={inPreview ? "What this pathway would hold if you chose it" : undefined}>
                {inPreview && <span class="group__if">if chosen </span>}
                {filled(tally)}
                <span class="group__of">/{tally.target}</span>
              </span>
            </span>
          )}
          <svg class="group__chevron" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
            <path d="m6 3.5 4.5 4.5L6 12.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </summary>

        <div class="group__body">
          <div class="group__intro">
            <p class="official">
              <span class="official__label">Official wording</span>
              {node.text}
            </p>
            {node.kind === "all" && node.link && (
              <a class="official-link" href={node.link.url} target="_blank" rel="noopener">
                {node.link.label} on Programs &amp; Courses<span class="visually-hidden"> (opens in a new tab)</span> ↗
              </a>
            )}
            {node.notes && node.notes.length > 0 && (
              <ul class="notes">
                {node.notes.map((n) => (
                  <li>{n}</li>
                ))}
              </ul>
            )}
            {pathwayOf && (
              <form class="choose" method="post" action="/api/choices" data-enhance data-astro-reload>
                <input type="hidden" name="node" value={pathwayOf.id} />
                <input type="hidden" name="option" value={isChosen ? "" : node.id} />
                <button class={isChosen ? "btn btn--quiet" : "btn"}>{isChosen ? "Clear this choice" : "Choose this pathway"}</button>
              </form>
            )}
          </div>

          {node.kind === "open" ? (
            <div class="bucket">
              {bucketEntries.length > 0 ? (
                <ol class="children" role="list" data-rel="open">
                  {bucketEntries.map((e) => (
                    <Leaf
                      code={e.courseCode}
                      course={catalogue.get(e.courseCode)}
                      entry={e}
                      nodeId={node.id}
                      credit={(inPreview ? evaluation.previewCredit : evaluation.credit).get(e.id)}
                      preview={inPreview}
                      target={(inPreview ? evaluation.previewCredit : evaluation.credit).get(e.id)?.units}
                    />
                  ))}
                </ol>
              ) : (
                <p class="bucket__empty">
                  {inPreview
                    ? "Nothing would be placed here yet."
                    : "Nothing counts here yet. Courses in your plan that aren't named elsewhere in this program fill open requirements like this one."}
                </p>
              )}
              <button class="btn btn--quiet" type="button" data-add-course>
                Add a course
              </button>
            </div>
          ) : (
            <ol class="children" role="list" data-rel={rel}>
              {node.kind === "one"
                ? node.options.map((option) => (
                    <Self node={option} evaluation={evaluation} catalogue={catalogue} choices={choices} pathwayOf={node} preview={preview} />
                  ))
                : node.children.map((child) => (
                    <Self node={child} evaluation={evaluation} catalogue={catalogue} choices={choices} parent={node} preview={inPreview} />
                  ))}
            </ol>
          )}
        </div>
      </details>
    </li>
  )
}
